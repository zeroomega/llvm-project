## Test reading ELF shared objects containing STB_GNU_UNIQUE symbols and
## emitting both IFS and ELF stubs. STB_GNU_UNIQUE symbols with default or
## protected visibility should record "Unique: true" in IFS text stubs and emit
## STB_GNU_UNIQUE with EI_OSABI set to ELFOSABI_GNU in ELF stubs (while keeping
## ELFOSABI_NONE when no Unique symbols are present). Hidden or internal symbols
## and STB_LOCAL symbols should be ignored, and exported symbols with
## unsupported bindings should be diagnosed.

# RUN: yaml2obj --docnum=1 %s -o %t.so
# RUN: llvm-ifs --input-format=ELF --output-ifs=%t.ifs %t.so
# RUN: FileCheck %s --check-prefix=IFS < %t.ifs
# RUN: llvm-ifs --input-format=IFS --output-ifs=- %t.ifs | FileCheck %s --check-prefix=IFS
# RUN: llvm-ifs --input-format=ELF --output-elf=%t.stub.so %t.so
# RUN: llvm-ifs --input-format=IFS --output-elf=%t.from-ifs.stub.so %t.ifs
# RUN: cmp %t.stub.so %t.from-ifs.stub.so
# RUN: llvm-readobj -h --dyn-symbols %t.stub.so | FileCheck %s --check-prefix=ELF
# RUN: llvm-ifs --input-format=ELF --output-ifs=%t.roundtrip.ifs --output-elf=%t.roundtrip.stub.so %t.stub.so
# RUN: FileCheck %s --check-prefix=IFS < %t.roundtrip.ifs
# RUN: cmp %t.stub.so %t.roundtrip.stub.so

# RUN: llvm-ifs --input-format=IFS --exclude='unique_*' --output-elf=%t.non-unique.stub.so %t.ifs
# RUN: llvm-readobj -h --dyn-symbols %t.non-unique.stub.so | FileCheck %s --check-prefix=NO-UNIQUE-ELF

# RUN: yaml2obj --docnum=3 %s -o %t.mixed.so
# RUN: llvm-ifs --input-format=ELF --output-ifs=%t.mixed.ifs --output-elf=%t.mixed.stub.so %t.mixed.so
# RUN: FileCheck %s --check-prefix=MIXED-IFS < %t.mixed.ifs
# RUN: llvm-readobj -h --dyn-symbols %t.mixed.stub.so | FileCheck %s --check-prefix=MIXED-ELF
# RUN: llvm-ifs --input-format=ELF --strip-undefined --output-elf=%t.mixed-stripped.stub.so %t.mixed.so
# RUN: llvm-readobj -h --dyn-symbols %t.mixed-stripped.stub.so | FileCheck %s --check-prefix=NO-UNIQUE-ELF

# RUN: yaml2obj --docnum=2 %s -o %t.bad.so
# RUN: not llvm-ifs --input-format=ELF --output-ifs=- %t.bad.so 2>&1 | FileCheck %s --check-prefix=ERR
# RUN: not llvm-ifs --input-format=ELF --output-elf=%t.bad.stub.so %t.bad.so 2>&1 | FileCheck %s --check-prefix=ERR

# IFS:      --- !ifs-v1
# IFS-NEXT: IfsVersion:      3.0
# IFS-NEXT: Target:          { ObjectFormat: ELF, Arch: x86_64, Endianness: little, BitWidth: 64 }
# IFS-NEXT: Symbols:
# IFS-NEXT:   - { Name: global_obj, Type: Object, Size: 4 }
# IFS-NEXT:   - { Name: unique_default, Type: Object, Size: 8, Unique: true }
# IFS-NEXT:   - { Name: unique_protected, Type: Object, Size: 16, Unique: true }
# IFS-NEXT:   - { Name: unique_tls, Type: TLS, Size: 4, Unique: true }
# IFS-NEXT:   - { Name: weak_obj, Type: Object, Size: 4, Weak: true }
# IFS-NEXT: ...

# ELF:      ElfHeader {
# ELF:        Ident {
# ELF:          OS/ABI: GNU/Linux (0x3)
# ELF:        }
# ELF:      DynamicSymbols [
# ELF-NEXT:   Symbol {
# ELF-NEXT:     Name:  (0)
# ELF-NEXT:     Value: 0x0
# ELF-NEXT:     Size: 0
# ELF-NEXT:     Binding: Local
# ELF-NEXT:     Type: None
# ELF-NEXT:     Other: 0
# ELF-NEXT:     Section: Undefined
# ELF-NEXT:   }
# ELF-NEXT:   Symbol {
# ELF-NEXT:     Name: global_obj
# ELF-NEXT:     Value: 0x0
# ELF-NEXT:     Size: 4
# ELF-NEXT:     Binding: Global
# ELF-NEXT:     Type: Object
# ELF-NEXT:     Other: 0
# ELF-NEXT:     Section: .dynsym
# ELF-NEXT:   }
# ELF-NEXT:   Symbol {
# ELF-NEXT:     Name: unique_default
# ELF-NEXT:     Value: 0x0
# ELF-NEXT:     Size: 8
# ELF-NEXT:     Binding: Unique
# ELF-NEXT:     Type: Object
# ELF-NEXT:     Other: 0
# ELF-NEXT:     Section: .dynsym
# ELF-NEXT:   }
# ELF-NEXT:   Symbol {
# ELF-NEXT:     Name: unique_protected
# ELF-NEXT:     Value: 0x0
# ELF-NEXT:     Size: 16
# ELF-NEXT:     Binding: Unique
# ELF-NEXT:     Type: Object
# ELF-NEXT:     Other: 0
# ELF-NEXT:     Section: .dynsym
# ELF-NEXT:   }
# ELF-NEXT:   Symbol {
# ELF-NEXT:     Name: unique_tls
# ELF-NEXT:     Value: 0x0
# ELF-NEXT:     Size: 4
# ELF-NEXT:     Binding: Unique
# ELF-NEXT:     Type: TLS
# ELF-NEXT:     Other: 0
# ELF-NEXT:     Section: .dynsym
# ELF-NEXT:   }
# ELF-NEXT:   Symbol {
# ELF-NEXT:     Name: weak_obj
# ELF-NEXT:     Value: 0x0
# ELF-NEXT:     Size: 4
# ELF-NEXT:     Binding: Weak
# ELF-NEXT:     Type: Object
# ELF-NEXT:     Other: 0
# ELF-NEXT:     Section: .dynsym
# ELF-NEXT:   }
# ELF-NEXT: ]

# NO-UNIQUE-ELF:      ElfHeader {
# NO-UNIQUE-ELF:        Ident {
# NO-UNIQUE-ELF:          OS/ABI: SystemV (0x0)
# NO-UNIQUE-ELF:        }
# NO-UNIQUE-ELF:      DynamicSymbols [
# NO-UNIQUE-ELF-NOT:    Binding: Unique
# NO-UNIQUE-ELF:      ]

# MIXED-IFS:      Symbols:
# MIXED-IFS-NEXT:   - { Name: global_obj, Type: Object, Size: 4 }
# MIXED-IFS-NEXT:   - { Name: undef_unique, Type: Object, Size: 8, Undefined: true, Unique: true }
# MIXED-IFS-NEXT: ...

# MIXED-ELF:      ElfHeader {
# MIXED-ELF:        Ident {
# MIXED-ELF:          OS/ABI: GNU/Linux (0x3)
# MIXED-ELF:        }
# MIXED-ELF:      DynamicSymbols [
# MIXED-ELF:        Name: undef_unique
# MIXED-ELF-NEXT:   Value: 0x0
# MIXED-ELF-NEXT:   Size: 8
# MIXED-ELF-NEXT:   Binding: Unique
# MIXED-ELF-NEXT:   Type: Object
# MIXED-ELF-NEXT:   Other: 0
# MIXED-ELF-NEXT:   Section: Undefined
# MIXED-ELF:      ]

# ERR: error: symbol 'unknown_bind_obj' has unsupported binding (13) when reading dynamic symbols

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  OSABI:   ELFOSABI_GNU
  Type:    ET_DYN
  Machine: EM_X86_64
Sections:
  - Name:         .dynsym
    Type:         SHT_DYNSYM
    Flags:        [ SHF_ALLOC ]
    Address:      0x100
    AddressAlign: 0x8
  - Name:         .dynstr
    Type:         SHT_STRTAB
    Flags:        [ SHF_ALLOC ]
    Address:      0x200
    AddressAlign: 0x1
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x300
    AddressAlign: 0x8
    Size:         0x40
  - Name:         .tdata
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE, SHF_TLS ]
    Address:      0x340
    AddressAlign: 0x4
    Size:         0x4
  - Name:         .dynamic
    Type:         SHT_DYNAMIC
    Flags:        [ SHF_ALLOC ]
    Address:      0x400
    Link:         .dynstr
    AddressAlign: 0x8
    Entries:
      - Tag:   DT_SYMTAB
        Value: 0x100
      - Tag:   DT_STRTAB
        Value: 0x200
      - Tag:   DT_STRSZ
        Value: 0x77
      - Tag:   DT_NULL
        Value: 0x0
DynamicSymbols:
  - Name:       local_obj
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_LOCAL
    Size:       4
  - Name:       global_obj
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_GLOBAL
    Size:       4
  - Name:       weak_obj
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_WEAK
    Size:       4
  - Name:       unique_default
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_GNU_UNIQUE
    Size:       8
  - Name:       unique_protected
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_GNU_UNIQUE
    Other:      [ STV_PROTECTED ]
    Size:       16
  - Name:       unique_hidden
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_GNU_UNIQUE
    Other:      [ STV_HIDDEN ]
    Size:       8
  - Name:       unique_internal
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_GNU_UNIQUE
    Other:      [ STV_INTERNAL ]
    Size:       8
  - Name:       unique_tls
    Type:       STT_TLS
    Section:    .tdata
    Binding:    STB_GNU_UNIQUE
    Size:       4
  - Name:       hidden_unknown
    Type:       STT_OBJECT
    Section:    .data
    Binding:    0xd # STB_LOPROC
    Other:      [ STV_HIDDEN ]
    Size:       4
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    VAddr:    0x100
    FirstSec: .dynsym
    LastSec:  .dynamic
  - Type:     PT_DYNAMIC
    Flags:    [ PF_R ]
    VAddr:    0x400
    FirstSec: .dynamic
    LastSec:  .dynamic

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  OSABI:   ELFOSABI_GNU
  Type:    ET_DYN
  Machine: EM_X86_64
Sections:
  - Name:         .dynsym
    Type:         SHT_DYNSYM
    Flags:        [ SHF_ALLOC ]
    Address:      0x100
    AddressAlign: 0x8
  - Name:         .dynstr
    Type:         SHT_STRTAB
    Flags:        [ SHF_ALLOC ]
    Address:      0x200
    AddressAlign: 0x1
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x300
    AddressAlign: 0x8
    Size:         0x10
  - Name:         .dynamic
    Type:         SHT_DYNAMIC
    Flags:        [ SHF_ALLOC ]
    Address:      0x400
    Link:         .dynstr
    AddressAlign: 0x8
    Entries:
      - Tag:   DT_SYMTAB
        Value: 0x100
      - Tag:   DT_STRTAB
        Value: 0x200
      - Tag:   DT_STRSZ
        Value: 0x12
      - Tag:   DT_NULL
        Value: 0x0
DynamicSymbols:
  - Name:       unknown_bind_obj
    Type:       STT_OBJECT
    Section:    .data
    Binding:    0xd # STB_LOPROC
    Size:       4
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    VAddr:    0x100
    FirstSec: .dynsym
    LastSec:  .dynamic
  - Type:     PT_DYNAMIC
    Flags:    [ PF_R ]
    VAddr:    0x400
    FirstSec: .dynamic
    LastSec:  .dynamic

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  OSABI:   ELFOSABI_NONE
  Type:    ET_DYN
  Machine: EM_X86_64
Sections:
  - Name:         .dynsym
    Type:         SHT_DYNSYM
    Flags:        [ SHF_ALLOC ]
    Address:      0x100
    AddressAlign: 0x8
  - Name:         .dynstr
    Type:         SHT_STRTAB
    Flags:        [ SHF_ALLOC ]
    Address:      0x200
    AddressAlign: 0x1
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x300
    AddressAlign: 0x8
    Size:         0x10
  - Name:         .dynamic
    Type:         SHT_DYNAMIC
    Flags:        [ SHF_ALLOC ]
    Address:      0x400
    Link:         .dynstr
    AddressAlign: 0x8
    Entries:
      - Tag:   DT_SYMTAB
        Value: 0x100
      - Tag:   DT_STRTAB
        Value: 0x200
      - Tag:   DT_STRSZ
        Value: 0x19
      - Tag:   DT_NULL
        Value: 0x0
DynamicSymbols:
  - Name:       global_obj
    Type:       STT_OBJECT
    Section:    .data
    Binding:    STB_GLOBAL
    Size:       4
  - Name:       undef_unique
    Type:       STT_OBJECT
    Binding:    STB_GNU_UNIQUE
    Size:       8
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    VAddr:    0x100
    FirstSec: .dynsym
    LastSec:  .dynamic
  - Type:     PT_DYNAMIC
    Flags:    [ PF_R ]
    VAddr:    0x400
    FirstSec: .dynamic
    LastSec:  .dynamic
